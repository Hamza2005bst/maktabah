{
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "framework": "vite"
    },
    "backend": {
      "routePrefix": "/_/backend",
      "rootDirectory": "backend",
      "buildCommand": "npm install",
      "startCommand": "npm start"
    }
  }
}
